# ==============================================================================
# Example Terraform Variables Configuration for GCP
# Copy this file to terraform.tfvars and fill in your values
# ==============================================================================

# Required: Your GCP Project ID
project_id = "your-gcp-project-id"

# Regional Placement
region = "europe-west1"
zone   = "europe-west1-b"

# Compute Engine Instance Sizing
machine_type = "e2-micro"

# Microsoft Entra ID (Azure AD) Credentials (Optional)
azure_client_id = "11111111-2222-3333-4444-555555555555"
azure_tenant_id = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"

# Custom Database Password (Optional - leave blank to auto-generate)
db_password = ""

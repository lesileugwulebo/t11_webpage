[Unit]
Description=Verdad Solution InventoryApp Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/verdad_inventory
ExecStart=/usr/bin/python3 /var/www/verdad_inventory/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5000

# Security Sandboxing (Optional / Best Practice)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
